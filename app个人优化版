#!/usr/bin/env python
# coding: utf-8

from flask import Flask, render_template, abort

app = Flask(__name__)


@app.route("/hello/<name>")
def hello(name):
    # 简单的输入校验，防止过长输入
    if len(name) > 50:
        abort(400, description="Name too long")

    # 只允许字母和空格
    if not name.replace(" ", "").isalpha():
        abort(400, description="Invalid characters in name")

    try:
        return render_template("template.txt", name=name)
    except Exception as e:
        # 如果模板不存在或渲染失败，返回友好提示
        return f"Template rendering error: {e}", 500


@app.route("/")
def home():
    return "Welcome to the Flask App! Use /hello/<name> to test."


if __name__ == "__main__":
    # 允许在本地直接运行
    app.run(host="0.0.0.0", port=5000, debug=True)

